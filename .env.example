# Private .env files are ignored by Git. Generate a real secret: openssl rand -hex 32
POSTGRES_PASSWORD=REMPLACER_PAR_UN_SECRET_HEXADECIMAL_ALEATOIRE
ATLAS_DATABASE_PASSWORD=REMPLACER_PAR_UN_AUTRE_SECRET_HEXADECIMAL_ALEATOIRE
ATLAS_PORT=8080
ATLAS_DOMAIN=atlas.example.org
ATLAS_ORIGIN=https://atlas.example.org
ATLAS_INSECURE_HTTP=false
ATLAS_REGISTRATION=false
# Native development only: optionally set ATLAS_WEB_DIR to the built web/dist path.

# Authenticated Compose selects /readyz automatically; standalone health defaults to /healthz.
# ATLAS_HEALTHCHECK_PATH=/readyz

# Fresh installation only: choose a stable Compose project; preserve an existing project name.
# COMPOSE_PROJECT_NAME=atlas
