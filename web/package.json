{
 "name": "@atlas/web",
 "private": true,
 "version": "0.0.0",
 "type": "module",
 "engines": {
  "node": ">=22.12.0"
 },
 "scripts": {
  "build": "tsc --noEmit && vite build",
  "typecheck": "tsc --noEmit",
  "lint": "eslint .",
  "test": "node --test test/*.test.mjs",
  "dev": "vite --host 127.0.0.1",
  "preview": "vite preview --host 127.0.0.1",
  "test:browser": "node test/browser.mjs",
  "test:e2e": "node test/identity.e2e.mjs",
  "test:a11y": "node test/accessibility.mjs",
  "test:portfolio": "node test/portfolio.e2e.mjs",
  "test:brokers": "node test/broker.e2e.mjs",
  "test:reconciliation": "node test/reconciliation.e2e.mjs",
  "test:readiness": "node test/readiness.e2e.mjs",
  "test:market-status": "node test/market-status.e2e.mjs",
  "test:keyboard": "node test/keyboard.e2e.mjs"
 },
 "dependencies": {
  "react": "19.3.1",
  "react-dom": "19.3.1"
 },
 "devDependencies": {
  "@axe-core/playwright": "4.14.0",
  "@types/react": "19.3.0",
  "@types/react-dom": "19.3.0",
  "eslint": "10.14.0",
  "playwright": "1.65.0",
  "typescript": "6.0.3",
  "typescript-eslint": "8.72.1",
  "vite": "8.3.6"
 },
 "overrides": {
  "minimatch": "11.0.1"
 }
}
